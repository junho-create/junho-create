# LiveKit (실시간 룸): https://cloud.livekit.io/
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# 아래 키들은 .env.local에 설정 (이 파일을 .env.local로 복사 후 값 입력)
OPENAI_API_KEY=
DEEPGRAM_API_KEY=

# ElevenLabs TTS (침착맨 목소리: 보이스 클로닝 후 voice_id 교체) - https://elevenlabs.io/app/settings/api-keys
ELEVEN_API_KEY=
# ELEVEN_VOICE_ID=   # 선택. 없으면 Adam(남성) 사용. 다른 보이스: https://elevenlabs.io/app/default-voices
# ELEVEN_TTS_MODEL= # 선택. 없으면 eleven_flash_v2_5(한국어 지원).

# LLM: 파인튜닝 모델 사용 시 완료 후 발급된 모델 ID(ft:gpt-4o-mini:...) 설정. job ID(ftjob-...) 아님.
# OPENAI_LLM_MODEL=   # 비우면 gpt-4o-mini 사용. 모델 ID는 scripts/get_ft_model_id.py 로 job ID에서 조회 가능
# LLM 프롬프트: 답변 스타일·길이 제어. 설정하면 기본 지시문 전체를 대체 (여러 줄 가능, 따옴표로 감싸거나 한 줄로)
# LLM_INSTRUCTIONS=   # 예: "친근하게 대화하고, 한 번에 3~5문장으로 구체적으로 답해. 한국어만 사용."

# TTS: 기본은 OpenAI TTS. ElevenLabs로 되돌리려면 TTS_PROVIDER=elevenlabs 추가
# TTS_PROVIDER=openai
# 아바타 룸에서만 쓸 TTS (설정 시 콘솔은 TTS_PROVIDER, 아바타 연결 시 이 값 사용). 스트리밍·립싱크 개선용으로 elevenlabs 권장
# TTS_PROVIDER_AVATAR=elevenlabs
# OPENAI_TTS_MODEL=  # 선택. 없으면 gpt-4o-mini-tts
# OPENAI_TTS_VOICE=  # 선택. 없으면 onyx (남성). alloy, ash, coral, echo, fable, onyx, nova, sage, shimmer

# Simli 아바타 (침착맨 외모: Simli에서 얼굴 생성 후 Face ID 입력) - https://app.simli.com/
SIMLI_API_KEY=
SIMLI_FACE_ID=
